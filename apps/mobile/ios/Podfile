# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'PogoLens' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Include resource bundles, which React Native's native-target adjustment skips.
    minimum_ios_target = Gem::Version.new(min_ios_version_supported)
    installer.pods_project.targets.each do |pod_target|
      deployment_targets = pod_target.resolved_build_setting('IPHONEOS_DEPLOYMENT_TARGET', true)
      pod_target.build_configurations.each do |build_config|
        current_target = deployment_targets[build_config.name]
        if current_target.nil? || current_target.to_s.empty?
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = minimum_ios_target.to_s
          next
        end

        unless Gem::Version.correct?(current_target.to_s)
          raise Pod::Informative, "Cannot resolve #{pod_target.name} #{build_config.name} iOS deployment target: #{current_target}"
        end
        if Gem::Version.new(current_target.to_s) < minimum_ios_target
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = minimum_ios_target.to_s
        end
      end
    end
  end
end
