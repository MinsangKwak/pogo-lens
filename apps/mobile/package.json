{
  "name": "@pogo-lens/mobile",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint App.tsx src __tests__ --ext .js,.ts,.tsx",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "bundle:android": "mkdir -p build && react-native bundle --platform android --dev false --max-workers 2 --entry-file index.js --bundle-output build/index.android.bundle --assets-dest build/android",
    "bundle:ios": "mkdir -p build && react-native bundle --platform ios --dev false --max-workers 2 --entry-file index.js --bundle-output build/main.jsbundle --assets-dest build/ios",
    "web": "vite --host 0.0.0.0",
    "build:web": "vite build",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "^5.5.2",
    "@pogo-lens/core": "0.1.0",
    "@pogo-lens/workflow": "0.1.0",
    "@react-native-async-storage/async-storage": "3.1.1",
    "react-native-web": "0.21.4",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3",
    "@testing-library/react-native": "14.1.0",
    "vite": "8.3.5",
    "@vitejs/plugin-react": "6.2.1",
    "@types/react-dom": "^19.2.0"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "codegenConfig": {
    "name": "PogoLensCaptureSpec",
    "type": "modules",
    "jsSrcsDir": "src/native",
    "android": {
      "javaPackageName": "dev.pogolens.app.nativebridge"
    },
    "ios": {
      "modulesProvider": {
        "PogoLensCapture": "PogoLensCapture"
      }
    }
  }
}
